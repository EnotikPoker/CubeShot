# Prefer manifest dependencies; native builds download the identical pinned headers.
find_package(Threads REQUIRED)
find_package(httplib 0.59.0 QUIET CONFIG)
find_package(nlohmann_json 3.12.0 QUIET CONFIG)
function(cubeshot_header url relative hash)
    set(path "${CMAKE_BINARY_DIR}/_online/include/${relative}")
    if(EXISTS "${path}")
        file(SHA256 "${path}" actual)
    endif()
    if(NOT actual STREQUAL hash)
        file(DOWNLOAD "${url}" "${path}" EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON)
    endif()
endfunction()
if(NOT TARGET httplib::httplib)
    cubeshot_header("https://raw.githubusercontent.com/yhirose/cpp-httplib/v0.59.0/httplib.h"
        httplib.h dc1e4de3e0ef3a18f3a5818fab563eb3fa45d5d3bb1db527a8d389077ed5ee6c)
    add_library(cubeshot_httplib INTERFACE)
    add_library(httplib::httplib ALIAS cubeshot_httplib)
    target_include_directories(cubeshot_httplib INTERFACE "${CMAKE_BINARY_DIR}/_online/include")
    target_compile_definitions(cubeshot_httplib INTERFACE CPPHTTPLIB_OPENSSL_SUPPORT)
    target_link_libraries(cubeshot_httplib INTERFACE OpenSSL::SSL OpenSSL::Crypto Threads::Threads)
    if(WIN32)
        target_link_libraries(cubeshot_httplib INTERFACE ws2_32 crypt32)
    endif()
endif()
if(NOT TARGET nlohmann_json::nlohmann_json)
    cubeshot_header("https://raw.githubusercontent.com/nlohmann/json/v3.12.0/single_include/nlohmann/json.hpp"
        nlohmann/json.hpp aaf127c04cb31c406e5b04a63f1ae89369fccde6d8fa7cdda1ed4f32dfc5de63)
    add_library(cubeshot_json INTERFACE)
    add_library(nlohmann_json::nlohmann_json ALIAS cubeshot_json)
    target_include_directories(cubeshot_json INTERFACE "${CMAKE_BINARY_DIR}/_online/include")
endif()
